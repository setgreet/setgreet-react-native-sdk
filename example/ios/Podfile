source 'https://cdn.cocoapods.org/'

# Enable new architecture by default, but can be overridden
ENV['RCT_NEW_ARCH_ENABLED'] = ENV.fetch('RCT_NEW_ARCH_ENABLED', '1')

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

# Specify the Xcode project to use
project 'ReactNativeSetgreetExample.xcodeproj'

# Static libraries, React Native's default. The SDK builds the same way with
# `use_frameworks! :linkage => :dynamic`.

# Lottie support (opt-in). SetgreetSDKLottie is a prebuilt framework that
# loads lottie-ios as a dynamic framework built with library evolution, so
# lottie-ios is built that way even though every other pod here is a static
# library. Remove this block, the `RNSetgreet/Lottie` line and the lottie-ios
# post_install setting to build without Lottie.
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name == 'lottie-ios'
      def pod.build_type
        Pod::BuildType.dynamic_framework
      end
    end
  end
end

target 'ReactNativeSetgreetExample' do
  config = use_native_modules!

  # SetgreetSDK itself comes from the RNSetgreet podspec, which pins the
  # version, so the example cannot drift from the wrapper. The Lottie subspec
  # is the opt-in for Lottie animations (see `registerLottie()` in App.tsx).
  pod 'RNSetgreet/Lottie', :path => '../node_modules/@setgreet/react-native-sdk'

  use_react_native!(
    :path => "../node_modules/react-native",
    :hermes_enabled => true,
    :fabric_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      "../node_modules/react-native",
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Ensure all pods use at least iOS 15.1 (React Native 0.79's minimum)
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < Gem::Version.new('15.1')
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end

      # Lottie support (opt-in, see pre_install above).
      if target.name == 'lottie-ios'
        target.build_configurations.each do |config|
          config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
        end
      end

      # Xcode 27 (Apple clang 21) rejects the consteval format-string checks in
      # fmt 11.0.2's own src/format.cc, which React Native 0.79 bundles. fmt
      # turns those checks on only from C++20, so build just the fmt pod as
      # C++17 (overriding the C++20 react_native_post_install sets above). A
      # -DFMT_USE_CONSTEVAL=0 does not work: fmt's base.h redefines it. Drop
      # this once the app is on a React Native with a newer fmt.
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
